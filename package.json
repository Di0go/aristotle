{
  "name": "mind-gym",
  "private": true,
  "type": "module",
  "description": "A personal mind gym: Claude Code is the tutor, this app is the gym.",
  "scripts": {
    "start": "vite build && node server/control.ts restart",
    "gym": "node server/control.ts",
    "serve": "node server/index.ts",
    "dev": "node --watch server/index.ts & vite; kill %1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test 'tests/*.test.ts'"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "katex": "^0.19.0",
    "marked": "^18.0.14",
    "mermaid": "^12.1.0",
    "node-pty": "^1.1.0",
    "ts-fsrs": "^5.4.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  }
}
