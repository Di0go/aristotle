{
  "enabledMcpjsonServers": [
    "aristotle"
  ],
  "disabledMcpjsonServers": [
    "aristotle-dev"
  ],
  "env": {
    "CLAUDE_CODE_MCP_AUTO_BACKGROUND_MS": "0"
  },
  "permissions": {
    "allow": [
      "mcp__aristotle",
      "WebSearch",
      "WebFetch"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/claude-stop-hook.ts",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
